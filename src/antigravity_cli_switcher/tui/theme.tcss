/* Textual CSS theme for antigravity-cli-switcher (ACS)
 * Rock-minimal, high-density, open-code aesthetic
 */

Screen {
    background: #0d1117;
    color: #e6edf3;
}

/* Header bar: 1 line flush top bar */
HeaderBar {
    dock: top;
    height: 1;
    min-height: 1;
    background: #161b22;
    color: #e6edf3;
    border: none;
    padding: 0 1;
}

#header-content {
    height: 1;
    color: #e6edf3;
}

/* Tabbed Navigation: 1 line flush tab bar */
TabbedContent {
    height: 1fr;
}

Tabs {
    dock: top;
    height: 1;
    min-height: 1;
    background: #0d1117;
    border: none;
    padding: 0;
    margin: 0;
}

Tab {
    height: 1;
    min-height: 1;
    padding: 0 1;
    margin: 0;
    border: none;
    background: transparent;
    color: #8b949e;
}

Tab:hover {
    color: #f0f6fc;
    background: #161b22;
}

Tab.-active {
    color: #58a6ff;
    text-style: bold;
    background: #161b22;
}

Tabs Underline {
    display: none;
}

TabPane {
    height: 1fr;
    padding: 0;
    margin: 0;
}

/* Primary Account Table: Borderless, high-density */
AccountTable {
    height: 1fr;
    border: none;
    background: #0d1117;
    margin: 0;
    padding: 0;
}

AccountTable > .datatable--header {
    background: #161b22;
    color: #8b949e;
    text-style: bold;
}

AccountTable > .datatable--cursor {
    background: #1b2a3d;
    color: #ffffff;
    text-style: bold;
}

AccountTable > .datatable--odd-row {
    background: #0f141c;
}

AccountTable > .datatable--even-row {
    background: #0d1117;
}

/* Detail Panel: Integrated bottom inspection pane */
DetailPanel {
    height: auto;
    max-height: 9;
    min-height: 3;
    border: none;
    border-top: solid #21262d;
    background: #11151c;
    margin: 0;
    padding: 0 1;
}

DetailPanel.collapsed {
    display: none;
}

#detail-title {
    height: 1;
    text-style: bold;
    color: #58a6ff;
    border: none;
    margin: 0;
    padding: 0;
}

#detail-content {
    color: #e6edf3;
}

/* Secondary Tabs: Fleet, Hygiene, History, Proxies */
ProxyTab, HygieneTab, HistoryTab, LogsTab, FleetTab {
    height: 1fr;
    padding: 0;
    margin: 0;
}

#proxy-summary, #hygiene-summary, #history-summary {
    height: 1;
    min-height: 1;
    background: #161b22;
    border: none;
    border-bottom: solid #21262d;
    padding: 0 1;
    margin: 0;
    color: #e6edf3;
}

#fleet-summary, #fleet-recommendation {
    height: auto;
    min-height: 1;
    max-height: 2;
    background: #161b22;
    border: none;
    border-bottom: solid #21262d;
    padding: 0 1;
    margin: 0;
    color: #e6edf3;
}

#proxy-table, #hygiene-table, #history-table, #fleet-table {
    height: 1fr;
    border: none;
    background: #0d1117;
    margin: 0;
    padding: 0;
}

#proxy-table > .datatable--header,
#hygiene-table > .datatable--header,
#history-table > .datatable--header,
#fleet-table > .datatable--header {
    background: #161b22;
    color: #8b949e;
    text-style: bold;
}

#proxy-table > .datatable--cursor,
#hygiene-table > .datatable--cursor,
#history-table > .datatable--cursor,
#fleet-table > .datatable--cursor {
    background: #1b2a3d;
    color: #ffffff;
    text-style: bold;
}

#proxy-table > .datatable--odd-row,
#hygiene-table > .datatable--odd-row,
#history-table > .datatable--odd-row,
#fleet-table > .datatable--odd-row {
    background: #0f141c;
}

#proxy-table > .datatable--even-row,
#hygiene-table > .datatable--even-row,
#history-table > .datatable--even-row,
#fleet-table > .datatable--even-row {
    background: #0d1117;
}

#proxy-actions, #hygiene-actions {
    height: 3;
    align: right middle;
    margin: 0;
    padding: 0 1;
    background: #161b22;
    border-top: solid #21262d;
}

#proxy-actions Button, #hygiene-actions Button {
    margin-left: 1;
}

/* Tab: Logs */
#logs-filter-bar {
    height: 1;
    min-height: 1;
    align: left middle;
    background: #161b22;
    border-bottom: solid #21262d;
    padding: 0 1;
    margin: 0;
}

#logs-filter-bar Button {
    height: 1;
    min-height: 1;
    min-width: 6;
    border: none;
    padding: 0 1;
    margin-right: 1;
}

#logs-filter-label {
    text-style: bold;
    color: #58a6ff;
    width: auto;
    margin-right: 1;
}

#logs-path-info {
    color: #8b949e;
    width: auto;
    margin-left: 2;
}

#logs-rich-log {
    height: 1fr;
    border: none;
    background: #0d1117;
    margin: 0;
    padding: 0 1;
}

/* Bottom Bar: Unified Footer and Status */
#bottom-container {
    dock: bottom;
    height: auto;
    background: #161b22;
    border-top: solid #21262d;
}

Footer {
    dock: none;
    height: 1;
    min-height: 1;
    background: transparent;
    color: #8b949e;
}

Footer > .footer--key {
    background: #21262d;
    color: #58a6ff;
    text-style: bold;
}

Footer > .footer--description {
    color: #8b949e;
}

StatusBar {
    dock: none;
    height: 1;
    min-height: 1;
    background: transparent;
    color: #8b949e;
    padding: 0 1;
}

#status-message {
    color: #e6edf3;
}

/* Modals */
ModalScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.75);
}

.modal-dialog {
    width: 60;
    max-width: 95%;
    height: auto;
    overflow-y: auto;
    border: solid #30363d;
    background: #161b22;
    padding: 1 2;
}

.help-modal-dialog {
    width: 74;
    max-width: 95%;
    max-height: 90%;
    height: auto;
    overflow-y: auto;
    border: solid #30363d;
    background: #161b22;
    padding: 1 2;
}

.modal-title {
    text-align: center;
    text-style: bold;
    color: #58a6ff;
    margin-bottom: 1;
}

.modal-buttons {
    margin-top: 1;
    align: right middle;
    height: 3;
}

.modal-buttons Button {
    margin-left: 1;
}

.error-label {
    color: #f85149;
    text-style: bold;
    height: 1;
    margin-top: 1;
}
